{
  "name": "personal-kanban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal kanban boards for project work, readable and writable by Claude via MCP",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace @kanban/web",
    "typecheck": "tsc -b && tsc -p packages/core/tsconfig.test.json && tsc -p packages/mcp/tsconfig.test.json && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "tsc -b --clean",
    "dev:web": "npm run dev --workspace @kanban/web"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
